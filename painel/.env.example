# Na Vercel: Project Settings > Environment Variables. NUNCA suba o .env para o GitHub.
META_ACCESS_TOKEN=            # token do usuário do sistema (ads_read + ads_management)
META_AD_ACCOUNT_ID=           # só números, sem "act_"
META_API_VERSION=v22.0
PAINEL_SENHA=                 # senha de entrada do painel (use uma longa)
PAINEL_SEGREDO=               # texto aleatório longo (32+ caracteres) para assinar a sessão
META_CUSTO_CONVERSA=3.00      # sua meta de custo por conversa (R$)
ANTHROPIC_API_KEY=            # chave da API da Anthropic (console.anthropic.com), só na Vercel
ANTHROPIC_MODEL=              # opcional; padrão claude-opus-5-5. Mais barato: claude-sonnet-5-5
CONCORRENTES=                 # nomes/perfis separados por vírgula, ex.: Loja A, Loja B
